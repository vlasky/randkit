#!/usr/bin/env python3
import argparse
import math
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from randkit import cli_setup, uniform


def exponential_sample(lam):
    """Sample from Exponential(λ) via inverse transform: -ln(U)/λ."""
    return -math.log(uniform()) / lam


def main():
    cli_setup()
    parser = argparse.ArgumentParser(
        description="Sample from an exponential distribution (continuous, non-negative). "
                    "Models the waiting time between events that occur at a constant average "
                    "rate λ. Output is one non-negative float per line. "
                    "The distribution has mean 1/λ and standard deviation 1/λ.",
        epilog="Algorithm:\n"
               "  Inverse transform: -ln(U)/λ where U is uniform in (0,1).\n"
               "  Exact and unbiased. One 64-bit read from /dev/urandom per sample.\n"
               "\n"
               "Relationship to Poisson:\n"
               "  If events arrive at rate λ (Poisson process), the time between\n"
               "  consecutive events is Exponential(λ). Poisson counts events in a\n"
               "  fixed interval; Exponential measures the interval between events.\n"
               "\n"
               "Examples:\n"
               "  exponential --lambda 1          # Mean wait = 1.0\n"
               "  exponential --lambda 0.5 -c 10  # Mean wait = 2.0, 10 samples\n"
               "  exponential --lambda 5 -c 5     # Mean wait = 0.2, 5 samples\n",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--lambda", dest="lam", type=float, default=1.0,
                        help="Rate parameter λ; must be positive (default: 1). Mean of output is 1/λ.")
    parser.add_argument("-c", "--count", type=int, default=1,
                        help="Number of samples to output, one per line (default: 1)")

    args = parser.parse_args()

    if args.count < 1:
        parser.error("count must be a positive integer")
    if not math.isfinite(args.lam) or args.lam <= 0:
        parser.error("lambda must be a positive finite number")

    for _ in range(args.count):
        print(f"{exponential_sample(args.lam):.15g}")


if __name__ == "__main__":
    main()
