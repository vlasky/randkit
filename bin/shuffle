#!/bin/bash
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat <<'EOF'
usage: shuffle [-h] [ITEM ...]

Randomly shuffle a list of items and print them in uniformly random order,
one per line. Items can be provided as command-line arguments or piped via
stdin (one item per line). If both are provided, only arguments are used.

positional arguments:
  ITEM        Items to shuffle (any strings, numbers, words, etc.)

options:
  -h, --help  show this help message and exit

Examples:
  shuffle 1 2 3 4 5              # prints 1-5 in random order
  shuffle red green blue         # shuffles words
  echo -e "a\nb\nc" | shuffle   # reads lines from stdin
  seq 1 100 | shuffle            # shuffles piped input
EOF
    exit 0
fi

# Random-byte source: stream /dev/urandom as decimal bytes on FD 3.
# awk consumes a line at a time and dispenses bytes from an internal buffer.
exec 3< <(od -An -tu1 -v /dev/urandom)

# Items come from cmdline args (printf) or stdin (passthrough). The awk
# program does the Fisher-Yates shuffle in place — no bash array load,
# no per-swap fork.
{
    if (( $# > 0 )); then
        printf '%s\n' "$@"
    else
        cat
    fi
} | awk '
    function refill_buf(   line) {
        if ((getline line < "/dev/fd/3") <= 0) {
            print "shuffle: /dev/urandom read failed" > "/dev/stderr"
            exit 2
        }
        buf_n = split(line, buf, " ")
        buf_i = 0
    }
    function rand_byte() {
        if (buf_i >= buf_n) refill_buf()
        buf_i++
        return buf[buf_i] + 0
    }
    # Uniform integer in [0, range) via rejection sampling.
    function rand_range(range,   nbytes, cap, thresh, v, i) {
        if (range <= 256)              { nbytes = 1; cap = 256 }
        else if (range <= 65536)       { nbytes = 2; cap = 65536 }
        else                           { nbytes = 4; cap = 4294967296 }
        thresh = cap - (cap % range)
        while (1) {
            v = 0
            for (i = 0; i < nbytes; i++) v = v * 256 + rand_byte()
            if (v < thresh) return v % range
        }
    }
    { items[NR-1] = $0 }
    END {
        n = NR
        if (n == 0) {
            print "usage: shuffle [-h] [ITEM ...]" > "/dev/stderr"
            print "Provide items as arguments or pipe lines to stdin." > "/dev/stderr"
            exit 1
        }
        for (i = n - 1; i > 0; i--) {
            j = rand_range(i + 1)
            tmp = items[i]; items[i] = items[j]; items[j] = tmp
        }
        for (i = 0; i < n; i++) print items[i]
    }
'
