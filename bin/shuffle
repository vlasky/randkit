#!/bin/bash
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat <<'EOF'
usage: shuffle [-h] [ITEM ...]

Randomly shuffle a list of items and print them in uniformly random order,
one per line. Items can be provided as command-line arguments or piped via
stdin (one item per line). If both are provided, only arguments are used.

positional arguments:
  ITEM        Items to shuffle (any strings, numbers, words, etc.)

options:
  -h, --help  show this help message and exit

Examples:
  shuffle 1 2 3 4 5              # prints 1-5 in random order
  shuffle red green blue         # shuffles words
  echo -e "a\nb\nc" | shuffle   # reads lines from stdin
  seq 1 100 | shuffle            # shuffles piped input
EOF
    exit 0
fi

# shellcheck source=lib/rand-awk.sh
. "$(dirname "$0")/../lib/rand-awk.sh"

randkit_open_byte_stream

# Items come from cmdline args (printf) or stdin (passthrough). The awk
# program does the Fisher-Yates shuffle in place — no bash array load,
# no per-swap fork.
{
    if (( $# > 0 )); then
        printf '%s\n' "$@"
    else
        cat
    fi
} | awk "$RANDKIT_AWK_LIB"'
    { items[NR-1] = $0 }
    END {
        n = NR
        if (n == 0) {
            print "usage: shuffle [-h] [ITEM ...]" > "/dev/stderr"
            print "Provide items as arguments or pipe lines to stdin." > "/dev/stderr"
            exit 1
        }
        for (i = n - 1; i > 0; i--) {
            j = rand_range(i + 1)
            tmp = items[i]; items[i] = items[j]; items[j] = tmp
        }
        for (i = 0; i < n; i++) print items[i]
    }
'
