#!/usr/bin/env python3
import argparse
import os
import struct


def uniform():
    """Uniform random float in (0, 1) from /dev/urandom.

    (top 53 bits + 0.5) / 2^53 is exact in double arithmetic, so the result
    is strictly inside (0, 1) — no rounding to 0.0 or 1.0 is possible."""
    u = struct.unpack('Q', os.urandom(8))[0]
    return ((u >> 11) + 0.5) * 2.0**-53


def binomial_sample(n, p):
    """Sample from Binomial(n, p) via n Bernoulli trials."""
    count = 0
    for _ in range(n):
        if uniform() < p:
            count += 1
    return count


def main():
    parser = argparse.ArgumentParser(
        description="Sample from a binomial distribution (discrete, bell-shaped). "
                    "Simulates flipping a biased coin n times and counting successes. "
                    "Output is one integer per line in the range [0, n]. "
                    "The distribution is centered at n*p with standard deviation sqrt(n*p*(1-p)).",
        epilog="Examples:\n"
               "  binomial                      # One sample from Binomial(10, 0.5), range 0-10\n"
               "  binomial --n 20 --p 0.3       # Binomial(20, 0.3), range 0-20, centered ~6\n"
               "  binomial --n 100 --p 0.5 -c 5 # 5 samples, range 0-100, centered ~50\n",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--n", type=int, default=10,
                        help="Number of trials; output will be an integer in [0, n] (default: 10)")
    parser.add_argument("--p", type=float, default=0.5,
                        help="Probability of success on each trial, between 0 and 1 (default: 0.5)")
    parser.add_argument("-c", "--count", type=int, default=1,
                        help="Number of samples to output, one per line (default: 1)")

    args = parser.parse_args()

    if args.count < 1:
        parser.error("count must be a positive integer")
    if args.n < 0:
        parser.error("n must be non-negative")
    if not 0 <= args.p <= 1:
        parser.error("p must be between 0 and 1")

    for _ in range(args.count):
        print(binomial_sample(args.n, args.p))


if __name__ == "__main__":
    main()
